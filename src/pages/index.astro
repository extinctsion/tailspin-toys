---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="mb-6 flex items-center gap-3">
            <label for="game-sort" class="text-sm font-medium text-slate-200">Sort games</label>
            <select
              id="game-sort"
              class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="game-sort"
            >
              <option value="title-asc">Title (A-Z)</option>
              <option value="title-desc">Title (Z-A)</option>
              <option value="rating-desc">Rating (highest first)</option>
            </select>
            <span class="sr-only" data-testid="sort-status" aria-live="polite"></span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const sortControl = document.querySelector<HTMLSelectElement>('[data-testid="game-sort"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const sortStatus = document.querySelector<HTMLElement>('[data-testid="sort-status"]');

  sortControl?.addEventListener('change', () => {
    if (!gamesGrid || !sortControl) return;

    const cards = [...gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
    cards.sort((a, b) => {
      if (sortControl.value === 'rating-desc') {
        const ratingA = Number.parseFloat(a.dataset.gameRating ?? '');
        const ratingB = Number.parseFloat(b.dataset.gameRating ?? '');
        const unratedA = Number.isNaN(ratingA);
        const unratedB = Number.isNaN(ratingB);

        if (unratedA !== unratedB) return unratedA ? 1 : -1;
        if (!unratedA && ratingA !== ratingB) return ratingB - ratingA;
      }

      const titleComparison = (a.dataset.gameTitle ?? '').localeCompare(b.dataset.gameTitle ?? '');
      return sortControl.value === 'title-desc' ? -titleComparison : titleComparison;
    });

    gamesGrid.replaceChildren(...cards);
    if (sortStatus) {
      sortStatus.textContent = `Games sorted by ${sortControl.selectedOptions[0]?.textContent ?? 'selected order'}.`;
    }
  });
</script>
