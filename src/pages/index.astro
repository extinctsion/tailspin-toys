---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/80 p-4 shadow-lg" data-testid="game-filters">
      <form id="game-filter-form" class="flex flex-col gap-4 lg:flex-row lg:items-end">
        <div class="flex-1">
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
          <select
            id="category-filter"
            name="category"
            multiple
            size={Math.min(categories.length || 1, 6)}
            aria-label="Filter by category"
            data-testid="category-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            {categories.map((category) => (
              <option value={category.id}>{category.name}</option>
            ))}
          </select>
        </div>

        <div class="min-w-64">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            aria-label="Filter by publisher"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="submit"
            data-testid="apply-filters"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors duration-200 hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Apply filters
          </button>

          <button
            type="reset"
            data-testid="clear-filters"
            class="inline-flex items-center justify-center rounded-lg border border-slate-600 bg-slate-900 px-4 py-2 font-medium text-slate-200 transition-colors duration-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Clear filters
          </button>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div data-testid="games-empty-state" hidden class="mb-6">
            <EmptyState text="No games match your selected filters." />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.getElementById('game-filter-form');
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
  const publisherFilter = document.getElementById('publisher-filter') as HTMLSelectElement | null;
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  function updateVisibleCards() {
    const selectedCategoryIds = Array.from(categoryFilter?.selectedOptions ?? []).map((option) => Number(option.value));
    const selectedPublisherId = publisherFilter && publisherFilter.value ? Number(publisherFilter.value) : null;

    let visibleCount = 0;
    for (const card of gameCards) {
      const categoryId = Number(card.getAttribute('data-game-category') ?? '0');
      const publisherId = Number(card.getAttribute('data-game-publisher') ?? '0');
      const matchesCategory = selectedCategoryIds.length === 0 || selectedCategoryIds.includes(categoryId);
      const matchesPublisher = selectedPublisherId === null || selectedPublisherId === publisherId;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    }

    const emptyState = document.querySelector<HTMLElement>('[data-testid="games-empty-state"]');
    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  }

  if (filterForm && categoryFilter && publisherFilter) {
    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      updateVisibleCards();
    });

    filterForm.addEventListener('reset', () => {
      requestAnimationFrame(updateVisibleCards);
    });
  }
</script>
